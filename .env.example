# Copy to .env (gitignored) for local Full / IBKR.

# Deployment mode: full (default) | lite
# lite = online slim site (Yahoo only; no IBKR)
# LEIBOT_MODE=lite

# Market history primary on Full: ibkr | yahoo
# LEIBOT_DATA_SOURCE=ibkr

# IBKR connection profiles (same adapter; separate sockets)
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=7497
IBKR_LIVE_PORT=7496
IBKR_CLIENT_ID=71
IBKR_LIVE_CLIENT_ID=72
# Optional override: PAPER | LIVE (else Settings → ibkr_connection_mode)
# IBKR_MODE=PAPER

# Hard safety: LIVE order placement. Default false.
# Selecting LIVE in Settings does NOT enable this.
LIVE_TRADING_ENABLED=false

# Phase 5 HTTPS sync (optional)
LEIBOT_MARKET_SYNC_API_KEY=replace-with-long-random-secret
