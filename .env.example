# Copy to .env (gitignored) for local Phase 5 sync client tests.
# Generate a long random secret (min 16 chars). Never commit the real value.

LEIBOT_MARKET_SYNC_API_KEY=replace-with-long-random-secret

# Deployment mode: full (default) | lite
# lite = online slim site (Watchlist My+NDX100, Stock Tracker news, Sector Rotation)
# LEIBOT_MODE=lite
